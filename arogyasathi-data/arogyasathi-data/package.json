{
  "name": "arogyasathi-data-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:ai-service": "cd ai-service && npm install",
    "postinstall": "npm run install:frontend && npm run install:backend && npm run install:ai-service",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:ai-service": "cd ai-service && npm run dev",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ai-service\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
